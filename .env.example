# ── Publish / personal-site mode ─────────────────────────────────────────────
# All credentials are server-side only. The public UI has no key/model panels.
# Copy to .env (never commit real secrets) and set on your host's env/secrets.

# Required for WeRead data load, proxy, SQLite sync, and background refresh.
WEREAD_API_KEY=""

# Optional custom WeRead agent gateway (defaults to official endpoint).
WEREAD_API_URL="https://i.weread.qq.com/api/agent/gateway"

# SQLite server cache + delta sync (default on). Set 0 only for static hosts.
WEREAD_SERVER_SYNC="1"

# Optional: encrypt stored keys for multi-account / headless scheduler (32+ chars).
# SERVER_SECRET=""

# ── Analysis (optional) ──────────────────────────────────────────────────────
# Prefer one of: XAI_API_KEY, ANALYSIS_API_KEY, or GEMINI_API_KEY.
# When set, /api/weread/analyze uses the server config; visitors never enter keys.

# xAI Grok (Responses API defaults applied automatically when XAI_API_KEY is set)
# XAI_API_KEY=""

# Or generic OpenAI-compatible / Responses / Anthropic-style provider:
# ANALYSIS_API_KEY=""
# ANALYSIS_API_ENDPOINT="https://api.x.ai/v1/responses"
# ANALYSIS_API_MODEL="grok-4.3"

# Or Google Gemini:
# GEMINI_API_KEY=""

# Public site URL (optional; used for self-referential links if needed).
# APP_URL="https://example.com"
